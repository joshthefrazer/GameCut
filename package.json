{
  "name": "gamecut",
  "version": "2.1.0",
  "private": true,
  "type": "module",
  "main": "electron-main.cjs",
  "description": "Strike — the video editor for gaming clips and shorts.",
  "homepage": "https://joshthefrazer.github.io/GameCut/",
  "author": {
    "name": "Frazer's Softwares"
  },
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win --x64",
    "dist:all": "electron-builder -wml",
    "icon": "python3 qa/make-icon.py",
    "test": "node qa/qa.mjs qa/out",
    "test:electron": "node qa/electron.mjs qa/out",
    "test:media": "node qa/media-electron.mjs qa/out",
    "test:packaged": "node qa/packaged.mjs ./dist/linux-unpacked/gamecut qa/out",
    "test:export": "node qa/export.mjs qa/out",
    "test:export-sink": "node qa/export-sink.mjs qa/out",
    "test:export-edge": "node qa/export-edge.mjs qa/out",
    "test:quality": "node qa/quality.mjs",
    "test:gfx": "node qa/gfx-real.mjs qa/out",
    "test:timeline": "node qa/timeline.mjs qa/out",
    "test:media-io": "node qa/media-io.mjs qa/out",
    "test:engine": "node qa/engine.mjs qa/out",
    "test:timeline-next": "node qa/timeline-next.mjs",
    "test:ui-next": "node qa/ui-next.mjs",
    "test:features": "node qa/features.mjs",
    "test:features2": "node qa/features2.mjs",
    "test:smart-crop": "node qa/smart-crop.mjs",
    "test:resolution": "node qa/resolution.mjs qa/out",
    "test:crop-box": "node qa/crop-box.mjs qa/out",
    "test:text-motion": "node qa/text-motion.mjs qa/out",
    "test:long": "node qa/longform.mjs",
    "diag:chrome": "node qa/chrome-cost.mjs",
    "diag:fps": "node qa/playback-fps.mjs",
    "diag:export": "node qa/export-cost.mjs",
    "update": "node tools/make-update.mjs",
    "keygen": "node tools/keygen.mjs",
    "release": "node tools/release.mjs",
    "test:update": "node qa/update-net.mjs",
    "site:init": "node tools/site-init.mjs",
    "site:preview": "node tools/site-preview.mjs",
    "test:site": "node qa/site.mjs",
    "test:installer": "node qa/installer.mjs",
    "test:reopen": "node qa/reopen.mjs qa/out",
    "test:stutter": "node qa/stutter.mjs qa/out",
    "test:freeze": "node qa/freeze.mjs qa/out",
    "dist:linux": "electron-builder --linux AppImage deb --x64"
  },
  "devDependencies": {
    "electron": "^44.6.0",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "com.gamecut.studio",
    "productName": "Strike",
    "copyright": "Copyright © 2026 Frazer's Softwares",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "electron-main.cjs",
      "preload.cjs",
      "updater.cjs",
      "inbox.cjs",
      "file-body.cjs",
      "update-config.json",
      "index.html",
      "src/**/*",
      "styles/**/*",
      "vendor/**/*",
      "assets/**/*",
      "package.json",
      "!**/*.map",
      "!**/.DS_Store",
      "!qa/**",
      "!build/**",
      "!dist/**"
    ],
    "win": {
      "icon": "build/icon.ico",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "dir",
          "arch": [
            "x64"
          ]
        }
      ],
      "artifactName": "${productName}-${version}-${arch}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": false,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Strike",
      "deleteAppDataOnUninstall": false,
      "include": "build/installer.nsh",
      "allowElevation": true,
      "runAfterFinish": true
    },
    "mac": {
      "target": [
        "dmg"
      ],
      "category": "public.app-category.video"
    },
    "linux": {
      "target": [
        {
          "target": "AppImage",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "deb",
          "arch": [
            "x64"
          ]
        }
      ],
      "category": "AudioVideo",
      "icon": "build/icon.png",
      "executableName": "gamecut",
      "synopsis": "Video editor for gaming clips",
      "description": "Desktop video editor for gaming clips: multi-track timeline, titles, transitions and fast exports.",
      "maintainer": "Frazer's Softwares <joshthefrazer@users.noreply.github.com>",
      "artifactName": "${productName}-${version}-${arch}.${ext}",
      "desktop": {
        "StartupWMClass": "GameCut",
        "Keywords": "video;editor;clips;gaming;montage;"
      }
    },
    "deb": {
      "packageCategory": "video",
      "priority": "optional"
    },
    "publish": null,
    "electronLanguages": [
      "en-US"
    ],
    "compression": "maximum",
    "afterPack": "build/after-pack.cjs"
  },
  "engines": {
    "node": ">=18"
  }
}
